# BookOS — aplicaciones por defecto del sistema.
# Los usuarios pueden cambiarlas; esto solo define el valor inicial.
[Default Applications]
text/plain=bookos-notepad.desktop
text/markdown=bookos-notepad.desktop
application/x-shellscript=bookos-notepad.desktop
application/json=bookos-notepad.desktop
text/x-log=bookos-notepad.desktop
image/png=bookos-viewer.desktop
image/jpeg=bookos-viewer.desktop
image/webp=bookos-viewer.desktop
image/gif=bookos-viewer.desktop
image/bmp=bookos-viewer.desktop
image/svg+xml=bookos-viewer.desktop
inode/directory=bookos-explorer.desktop
text/html=bookos-browser.desktop
application/xhtml+xml=bookos-browser.desktop
x-scheme-handler/http=bookos-browser.desktop
x-scheme-handler/https=bookos-browser.desktop
